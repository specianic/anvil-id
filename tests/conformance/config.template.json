{
  "alias": "anvilid",
  "description": "anvilid release 0.1 (Basic OP + Config OP). Rendered by tests/conformance/setup.sh; placeholders are replaced with per-run values.",
  "server": {
    "discoveryUrl": "@BASE_URL@/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "@CLIENT_ID@",
    "client_secret": "@CLIENT_SECRET@"
  },
  "client2": {
    "client_id": "@CLIENT2_ID@",
    "client_secret": "@CLIENT2_SECRET@"
  },
  "client_secret_post": {
    "client_id": "@POST_CLIENT_ID@",
    "client_secret": "@POST_CLIENT_SECRET@"
  },
  "browser": [
    {
      "match": "@BASE_URL@/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "@BASE_URL@/ui/login*",
          "commands": [
            [
              "text",
              "id",
              "identifier",
              "@USER@"
            ],
            [
              "text",
              "id",
              "password",
              "@PASSWORD@"
            ],
            [
              "click",
              "id",
              "login-submit"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    }
  ],
  "override": {
    "oidcc-prompt-login": {
      "browser": [
        {
          "comment": "updates the placeholder with the login page shown during the second authorization",
          "match": "@BASE_URL@/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "@BASE_URL@/ui/login*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "id",
                  "identifier",
                  "@USER@"
                ],
                [
                  "text",
                  "id",
                  "password",
                  "@PASSWORD@"
                ],
                [
                  "click",
                  "id",
                  "login-submit"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-max-age-1": {
      "browser": [
        {
          "comment": "updates the placeholder with the login page shown during the second authorization",
          "match": "@BASE_URL@/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "@BASE_URL@/ui/login*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "id",
                  "identifier",
                  "@USER@"
                ],
                [
                  "text",
                  "id",
                  "password",
                  "@PASSWORD@"
                ],
                [
                  "click",
                  "id",
                  "login-submit"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-registered-redirect-uri": {
      "browser": [
        {
          "comment": "expect an error page instead of a redirect",
          "match": "@BASE_URL@/authorize*",
          "tasks": [
            {
              "task": "Expect redirect uri mismatch error page",
              "match": "@BASE_URL@/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "The redirect URI in this request is not registered for this client",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    }
  }
}
