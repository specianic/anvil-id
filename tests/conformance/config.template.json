{
  "alias": "anvilid",
  "description": "anvilid (Basic OP, Config OP, Form Post OP, RP-Initiated and Back-Channel Logout OP). Rendered by tests/conformance/setup.sh; placeholders are replaced with per-run values.",
  "server": {
    "discoveryUrl": "@BASE_URL@/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "@CLIENT_ID@",
    "client_secret": "@CLIENT_SECRET@"
  },
  "client2": {
    "client_id": "@CLIENT2_ID@",
    "client_secret": "@CLIENT2_SECRET@"
  },
  "client_secret_post": {
    "client_id": "@POST_CLIENT_ID@",
    "client_secret": "@POST_CLIENT_SECRET@"
  },
  "browser": [
    {
      "match": "@BASE_URL@/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "@BASE_URL@/ui/login*",
          "commands": [
            [
              "text",
              "id",
              "identifier",
              "@USER@"
            ],
            [
              "text",
              "id",
              "password",
              "@PASSWORD@"
            ],
            [
              "click",
              "id",
              "login-submit"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    },
    {
      "comment": "sign-out with a registered post_logout_redirect_uri: confirm if asked, then check that the browser landed on the suite's post_logout_redirect page. That page (suite template resultCaptured.html) has no submission_complete element, so the task only checks the URL, as the suite's own logout config does.",
      "match": "@BASE_URL@/logout*",
      "tasks": [
        {
          "task": "Confirm sign-out",
          "optional": true,
          "match": "@BASE_URL@/ui/logout*",
          "commands": [
            [
              "click",
              "id",
              "logout-confirm-submit"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/post_logout_redirect*"
        }
      ]
    }
  ],
  "override": {
    "oidcc-prompt-login": {
      "browser": [
        {
          "comment": "updates the placeholder with the login page shown during the second authorization",
          "match": "@BASE_URL@/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "@BASE_URL@/ui/login*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "id",
                  "identifier",
                  "@USER@"
                ],
                [
                  "text",
                  "id",
                  "password",
                  "@PASSWORD@"
                ],
                [
                  "click",
                  "id",
                  "login-submit"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-max-age-1": {
      "browser": [
        {
          "comment": "updates the placeholder with the login page shown during the second authorization",
          "match": "@BASE_URL@/authorize*",
