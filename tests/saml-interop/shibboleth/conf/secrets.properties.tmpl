# SAML interop (tests/saml-interop/run.sh): the layout of Shibboleth IdP 5.2.3's
# credentials/secrets.properties. Every value is generated per run; nothing here is a real secret.

# Access to internal AES encryption key (per-run sealer.jks)
idp.sealer.storePassword = @@SHIB_SEALER_PASSWORD@@
idp.sealer.keyPassword = @@SHIB_SEALER_PASSWORD@@

# Password for the per-run idp-backchannel.p12
idp.backchannel.keyStorePassword = @@SHIB_BACKCHANNEL_PASSWORD@@

# No LDAP is used; random per-run values keep the properties defined.
idp.authn.LDAP.bindDNCredential              = @@SHIB_LDAP_PLACEHOLDER@@
idp.attribute.resolver.LDAP.bindDNCredential = @@SHIB_LDAP_PLACEHOLDER@@

# Salt used to generate persistent IDs
idp.persistentId.salt = @@SHIB_PERSISTENT_ID_SALT@@
