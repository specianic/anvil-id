{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anvilid.dev/schemas/tenant-config-v1.json",
  "title": "AnvilID TenantConfig document, version 1",
  "description": "Declarative configuration of one AnvilID tenant (docs/CONFIG-YAML.md). Objects are keyed by natural keys, never database ids. Exports carry secrets only as {configured: bool} and logos as {sha256, content_type}. The CLI additionally accepts {env: NAME} and {file: path} secret references and {file: path} logo references, which it resolves before the document reaches the server; the admin API accepts {configured} and {value} secrets and {data} or {sha256, content_type} logos only. Optional keys added within version 1 keep today's meaning when absent, also with prune: an absent logo keeps the stored logo, an absent organizations key touches no organization. Server-side validation (redirect URI rules, schemas of attributes, template compilation, ...) goes beyond this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "tenant"],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "TenantConfig" },
    "tenant": { "$ref": "#/$defs/tenant" },
    "clients": {
      "description": "Static clients, keyed by client_id. Dynamic (RFC 7591) and Client ID Metadata Document clients are runtime state and never listed.",
      "type": "array",
      "items": { "$ref": "#/$defs/client" }
    },
    "connections": {
      "description": "Upstream identity providers, keyed by slug.",
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    },
    "branding": {
      "description": "Tenant-wide branding (no client_id) and per-client overrides, each with an optional logo.",
      "type": "array",
      "items": { "$ref": "#/$defs/branding" }
    },
    "roles": {
      "description": "Roles, keyed by name. Role assignments are never part of the document.",
      "type": "array",
      "items": { "$ref": "#/$defs/role" }
    },
    "attributes": {
      "description": "Custom user attribute definitions, keyed by name.",
      "type": "array",
      "items": { "$ref": "#/$defs/attribute" }
    },
    "email_templates": {
      "description": "Customized email templates, keyed by kind.",
      "type": "array",
      "items": { "$ref": "#/$defs/email_template" }
    },
    "smtp": {
      "description": "Tenant SMTP settings; absent or null = the installation SMTP.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/smtp" }]
    },
    "webhooks": {
      "description": "Webhook endpoints, keyed by name.",
      "type": "array",
      "items": { "$ref": "#/$defs/webhook" }
    },
    "organizations": {
      "description": "Organizations, keyed by slug, with their roles, connections, domain claims and branding. Absent = organizations are not managed (nothing planned, changed or pruned). Organizations are never deleted by a document; members, invitations, identity links, org role assignments and domain verification are never part of it. Refused for the system tenant.",
      "type": "array",
      "items": { "$ref": "#/$defs/organization" }
    }
  },
  "$defs": {
    "secret": {
      "description": "A secret field. {configured: true} keeps the stored value (false clears it where allowed), {value: ...} sets it. CLI only: {env: NAME} or {file: path}.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["configured"],
          "properties": { "configured": { "type": "boolean" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": { "value": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": { "env": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": { "file": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "logo": {
      "description": "A logo. Absent keeps the stored logo; null clears it; {data} sets it from base64 image bytes (PNG, JPEG or WebP, at most 256 KiB, SVG refused); {sha256, content_type} names a logo already stored in the tenant (what an export writes). CLI only: {file: path}.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["data"],
          "properties": { "data": { "type": "string", "minLength": 1, "maxLength": 349528 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "content_type"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "content_type": { "enum": ["image/png", "image/jpeg", "image/webp"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": { "file": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "optional_secret": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/secret" }]
    },
    "optional_string": { "type": ["string", "null"] },
    "string_list": { "type": "array", "items": { "type": "string" } },
    "host_list": {
      "description": "Allow-listed host names or IP literals: at most 100, no duplicates (the server also compares case-insensitively and checks each entry's syntax).",
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 100,
      "uniqueItems": true
    },
    "registration_list": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 100
    },
    "mfa_policy": { "enum": ["off", "optional", "required"] },
    "token_target": { "enum": ["access_token", "id_token", "userinfo"] },
    "claim_rule": {
      "type": "object",
      "required": ["claim", "tokens"],
      "properties": {
        "claim": { "type": "string" },
        "tokens": { "type": "array", "items": { "$ref": "#/$defs/token_target" } },
        "scope": { "$ref": "#/$defs/optional_string" }
      }
    },
    "optional_claim_rule": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/claim_rule" }]
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "display_name"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "host": { "$ref": "#/$defs/optional_string" },
        "settings": { "$ref": "#/$defs/settings" }
      }
    },
    "settings": {
      "description": "Tenant settings; every field has a default. CAPTCHA is configured through the admin API and must not appear (captcha: null or absent).",
      "type": "object",
      "properties": {
        "registration": { "enum": ["open", "invite_only", "disabled"] },
        "require_verified_email": { "type": "boolean" },
        "signing_algs": {
          "type": "array",
          "items": { "enum": ["RS256", "ES256", "Ed25519"] }
        },
        "captcha": { "type": "null" },
        "mfa_policy": { "$ref": "#/$defs/mfa_policy" },
        "email_otp": { "type": "boolean" },
        "magic_link": { "type": "boolean" },
        "auto_link": { "type": "boolean" },
        "upstream_registration": { "type": ["boolean", "null"] },
        "default_locale": { "type": "string" },
        "dcr": {
          "description": "Dynamic client registration policy; must be disabled for the system tenant. Scope and resource syntax (no admin scopes, RFC 8707 resources) is checked by the server.",
          "type": "object",
          "properties": {
            "policy": { "enum": ["disabled", "allow_listed", "open"] },
            "allowed_redirect_hosts": { "$ref": "#/$defs/host_list" },
            "allowed_scopes": { "$ref": "#/$defs/registration_list" },
            "allowed_resources": { "$ref": "#/$defs/registration_list" },
            "allow_client_credentials": { "type": "boolean" },
            "max_clients": { "type": "integer", "minimum": 0, "maximum": 1000000 }
          }
        },
        "cimd": {
          "description": "Client ID Metadata Document policy; must be disabled for the system tenant. Cross-field rules are checked by the server, not this schema: min_cache_secs <= max_cache_secs, and allow_listed needs at least one host.",
          "type": "object",
          "properties": {
            "policy": { "enum": ["disabled", "allow_listed", "open"] },
            "allowed_hosts": { "$ref": "#/$defs/host_list" },
            "min_cache_secs": { "type": "integer", "minimum": 60, "maximum": 604800 },
            "max_cache_secs": { "type": "integer", "minimum": 60, "maximum": 604800 }
          }
        },
        "claims": {
          "type": "object",
          "properties": {
            "roles": { "$ref": "#/$defs/optional_claim_rule" },
            "permissions": { "$ref": "#/$defs/optional_claim_rule" },
            "org_roles": { "$ref": "#/$defs/optional_claim_rule" },
            "org_permissions": { "$ref": "#/$defs/optional_claim_rule" }
          }
        },
        "par": {
          "description": "Pushed authorization requests (RFC 9126). Omitted from exports when default.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_pushed_authorization_requests": { "type": "boolean" }
          }
        },
        "headless": {
          "description": "Headless flow API settings. Omitted from exports when default. Each origin is an exact lowercase https://host[:port] origin (no path, query, fragment, userinfo or wildcard; http://localhost and http://127.0.0.1 only in development mode); the server checks the exact rules.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_origins": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "pattern": "^https?://[^/?#@*\\s]+$" }
            }
          }
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "name", "client_type", "application_type", "auth_method"],
      "properties": {
        "client_id": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "client_type": { "enum": ["confidential", "public"] },
        "application_type": { "enum": ["web", "native"] },
        "auth_method": {
          "enum": ["client_secret_basic", "client_secret_post", "private_key_jwt", "none"]
        },
        "secret": { "$ref": "#/$defs/optional_secret" },
        "jwks": { "$ref": "#/$defs/optional_string" },
        "redirect_uris": { "$ref": "#/$defs/string_list" },
        "grant_types": {
          "type": "array",
          "items": { "enum": ["authorization_code", "refresh_token", "client_credentials"] }
        },
        "scopes": { "$ref": "#/$defs/string_list" },
        "require_pkce": { "type": "boolean" },
        "token_format": { "enum": ["jwt", "opaque"] },
        "consent_mode": { "enum": ["required", "skip_first_party"] },
        "id_token_signed_response_alg": { "$ref": "#/$defs/optional_string" },
        "can_introspect": { "type": "boolean" },
        "post_logout_redirect_uris": { "$ref": "#/$defs/string_list" },
        "backchannel_logout_uri": { "$ref": "#/$defs/optional_string" },
        "backchannel_logout_session_required": { "type": "boolean" },
        "allowed_resources": { "$ref": "#/$defs/string_list" },
        "mfa_policy": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/mfa_policy" }]
        },
        "organization": { "enum": ["off", "optional", "required"] },
        "require_pushed_authorization_requests": {
          "description": "RFC 9126 section 6: the client must use pushed authorization requests. Omitted from exports when false.",
          "type": "boolean"
        },
        "client_kind": {
          "description": "application (default, omitted from exports) or agent. An agent must use consent_mode required.",
          "enum": ["application", "agent"]
        },
        "headless_native": {
          "description": "May use the native headless flow API. Needs consent_mode skip_first_party, require_pkce true and client_kind application. Omitted from exports when false.",
          "type": "boolean"
        },
        "client_uri": {
          "description": "The client's home page: an absolute https URL (http only for localhost and loopback), no userinfo or fragment, at most 2048 characters. Omitted from exports when unset.",
          "type": ["string", "null"],
          "maxLength": 2048
        },
        "initiate_login_uri": {
          "description": "Where a sign-in started at AnvilID continues at the client. Same rules as client_uri. Omitted from exports when unset.",
          "type": ["string", "null"],
          "maxLength": 2048
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "display_name", "config"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "enabled": { "type": "boolean" },
        "config": { "$ref": "#/$defs/connection_config" },
        "secret": { "$ref": "#/$defs/optional_secret" },
        "trust_email_verified": { "type": "boolean" }
      }
    },
    "connection_config": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "provider", "client_id"],
          "properties": {
            "type": { "const": "social" },
            "provider": { "enum": ["google", "apple", "microsoft", "github"] },
            "client_id": { "type": "string" },
            "scopes": { "$ref": "#/$defs/string_list" },
            "endpoints": {
              "type": "object",
              "properties": {
                "issuer": { "$ref": "#/$defs/optional_string" },
                "authorization_endpoint": { "$ref": "#/$defs/optional_string" },
                "token_endpoint": { "$ref": "#/$defs/optional_string" },
                "userinfo_endpoint": { "$ref": "#/$defs/optional_string" },
                "jwks_uri": { "$ref": "#/$defs/optional_string" },
                "api_base_url": { "$ref": "#/$defs/optional_string" }
              }
            },
            "microsoft_tenant": { "$ref": "#/$defs/optional_string" },
            "allowed_tenants": { "$ref": "#/$defs/string_list" },
            "hosted_domains": { "$ref": "#/$defs/string_list" },
            "apple": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["team_id", "key_id"],
                  "properties": {
                    "team_id": { "type": "string" },
                    "key_id": { "type": "string" }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "issuer", "client_id"],
          "properties": {
            "type": { "const": "oidc" },
            "issuer": { "type": "string" },
            "client_id": { "type": "string" },
            "scopes": { "$ref": "#/$defs/string_list" },
            "use_pkce": { "type": "boolean" },
            "fetch_userinfo": { "type": "boolean" }
          }
        },
        {
          "description": "SAML 2.0 IdP: organization connections only, and only while the operator flag saml_experimental is on. Has no secret.",
          "type": "object",
          "required": ["type", "idp_entity_id", "sso_url", "signing_certs"],
          "properties": {
            "type": { "const": "saml" },
            "idp_entity_id": { "type": "string", "maxLength": 1024 },
            "sso_url": { "type": "string" },
            "signing_certs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": { "type": "string" }
            },
            "name_id_format": {
              "enum": ["unspecified", "email_address", "persistent", "transient"]
            },
            "attributes": {
              "type": "object",
              "properties": {
                "email": { "$ref": "#/$defs/optional_string" },
                "given_name": { "$ref": "#/$defs/optional_string" },
                "family_name": { "$ref": "#/$defs/optional_string" },
                "name": { "$ref": "#/$defs/optional_string" }
              }
            },
            "metadata_url": { "$ref": "#/$defs/optional_string" }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "authorization_endpoint",
            "token_endpoint",
            "userinfo_endpoint",
            "client_id",
            "mapping"
          ],
          "properties": {
            "type": { "const": "oauth2" },
            "authorization_endpoint": { "type": "string" },
            "token_endpoint": { "type": "string" },
            "userinfo_endpoint": { "type": "string" },
            "client_id": { "type": "string" },
            "scopes": { "$ref": "#/$defs/string_list" },
            "use_pkce": { "type": "boolean" },
            "mapping": {
              "type": "object",
              "required": ["subject"],
              "properties": {
                "subject": { "type": "string" },
                "email": { "$ref": "#/$defs/optional_string" },
                "email_verified": { "$ref": "#/$defs/optional_string" },
                "name": { "$ref": "#/$defs/optional_string" }
              }
            }
          }
        }
      ]
    },
    "theme_colors": {
      "type": "object",
      "properties": {
        "primary": { "$ref": "#/$defs/optional_string" },
        "primary_text": { "$ref": "#/$defs/optional_string" },
        "bg": { "$ref": "#/$defs/optional_string" },
        "surface": { "$ref": "#/$defs/optional_string" },
        "text": { "$ref": "#/$defs/optional_string" },
        "muted": { "$ref": "#/$defs/optional_string" },
        "border": { "$ref": "#/$defs/optional_string" },
        "focus": { "$ref": "#/$defs/optional_string" },
        "danger": { "$ref": "#/$defs/optional_string" }
      }
    },
    "theme_tokens": {
      "type": "object",
      "properties": {
        "colors": { "$ref": "#/$defs/theme_colors" },
        "colors_dark": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/theme_colors" }]
        },
        "font_family": { "$ref": "#/$defs/optional_string" },
        "radius_px": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_id": { "$ref": "#/$defs/optional_string" },
        "tokens": { "$ref": "#/$defs/theme_tokens" },
        "custom_css": { "$ref": "#/$defs/optional_string" },
        "logo": { "$ref": "#/$defs/logo" }
      }
    },
    "org_branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": { "$ref": "#/$defs/theme_tokens" },
        "custom_css": { "$ref": "#/$defs/optional_string" },
        "logo": { "$ref": "#/$defs/logo" }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "display_name"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mfa_policy": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/mfa_policy" }]
        },
        "metadata": {
          "description": "Free-form JSON object for the integrator.",
          "type": "object"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_roles": {
              "description": "Roles given to members created by just-in-time provisioning, by name: an organization role of this entry, otherwise a tenant role. At most 20.",
              "type": "array",
              "maxItems": 20,
              "items": { "type": "string" }
            }
          }
        },
        "roles": {
          "description": "Organization-owned roles, keyed by name. admin and admin:* permissions are refused.",
          "type": "array",
          "items": { "$ref": "#/$defs/role" }
        },
        "connections": {
          "description": "The organization's connections (OIDC; SAML while saml_experimental is on), keyed by slug. Slugs share one namespace with the tenant's connections.",
          "type": "array",
          "items": { "$ref": "#/$defs/connection" }
        },
        "domains": {
          "description": "Domain claims, keyed by domain. A document never marks a domain verified; routing settings take effect once the domain is verified through DNS.",
          "type": "array",
          "items": { "$ref": "#/$defs/org_domain" }
        },
        "branding": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/org_branding" }]
        }
      }
    },
    "org_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": { "type": "string", "minLength": 1, "maxLength": 253 },
        "connection": {
          "description": "Slug of the routing target, a connection of this organization.",
          "$ref": "#/$defs/optional_string"
        },
        "routing": { "type": "boolean" },
        "allow_local_password": { "type": "boolean" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
        "description": { "type": "string", "maxLength": 500 },
        "permissions": { "$ref": "#/$defs/string_list" }
      }
    },
    "attribute": {
      "type": "object",
      "required": ["name", "schema"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "schema": {
          "description": "JSON Schema (draft 2020-12, offline, at most 16 KiB) of the attribute's value.",
          "type": "object"
        },
        "required": { "type": "boolean" },
        "user_editable": { "type": "boolean" },
        "claim": { "$ref": "#/$defs/optional_claim_rule" },
        "position": { "type": "integer", "minimum": 0 }
      }
    },
    "email_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject", "body_html", "body_text"],
      "properties": {
        "kind": {
          "enum": [
            "verification",
            "recovery",
            "invitation",
            "password_changed",
            "recovery_code_used",
            "login_code",
            "email_change",
            "email_changed"
          ]
        },
        "subject": { "type": "string" },
        "body_html": { "type": "string" },
        "body_text": { "type": "string" }
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "from", "tls"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "$ref": "#/$defs/optional_string" },
        "password": { "$ref": "#/$defs/optional_secret" },
        "from": { "type": "string" },
        "tls": { "enum": ["starttls", "implicit", "none"] }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "url": { "type": "string" },
        "events": {
          "type": "array",
          "items": {
            "enum": [
              "user.created",
              "user.updated",
              "user.deleted",
              "user.email_verified",
              "user.email_changed",
              "user.password_changed",
              "session.created",
              "session.revoked",
              "session.logged_out"
            ]
          }
        },
        "enabled": { "type": "boolean" },
        "secret": { "$ref": "#/$defs/optional_secret" }
      }
    }
  }
}
