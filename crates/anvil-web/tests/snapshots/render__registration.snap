---
source: crates/anvil-web/tests/render.rs
expression: html
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Create an account · Acme</title>
<link rel="stylesheet" href="&#x2f;t&#x2f;acme&#x2f;assets/anvil.css">
</head>
<body>

<main id="main" aria-labelledby="page-heading">
<p class="anvil-tenant">Acme</p>
<h1 id="page-heading">Create an account</h1>

<form id="registration" method="post" action="&#x2f;t&#x2f;acme&#x2f;ui&#x2f;registration?flow=f1" novalidate>
<input type="hidden" name="csrf_token" value="csrf-sample-token">



<div class="anvil-field">
<label for="email">Email</label>
<input id="email" name="email" type="email" value="ada@example.test" required>

</div>




<div class="anvil-field">
<label for="name">Name</label>
<input id="name" name="name" type="text" value="Ada" required>

</div>




<div class="anvil-field anvil-field-invalid">
<label for="password">Password</label>
<input id="password" name="password" type="password" required aria-describedby="password-msg-1" aria-invalid="true">

<p class="anvil-message anvil-message-error" id="password-msg-1" data-message-key="password.too_short" role="alert">must be at least 8 characters</p>

</div>



<button type="submit" id="registration-submit">Create account</button>
</form>

<nav class="anvil-links" aria-label="Account help">
<a id="link-login" href="&#x2f;t&#x2f;acme&#x2f;ui&#x2f;login?flow=f1">Already have an account? Sign in</a>
</nav>


</main>
</body>
</html>
