  "query": "UPDATE role\n                SET name = COALESCE($3, name),\n                    description = COALESCE($4, description),\n                    permissions = COALESCE($5, permissions),\n                    updated_at = $6\n              WHERE tenant_id = $1 AND id = $2\n          RETURNING id, tenant_id, org_id, name, description, permissions, created_at,\n                    updated_at",
